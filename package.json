{
  "name": "auto-racer",
  "version": "0.0.1",
  "private": true,
  "description": "Core Loop prototype (feature 001-core-loop): prepare -> contest auto racer.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --noEmit",
    "build:pages": "VITE_DEMO_BASE_URL=/auto-racer/ vite build && tsc --noEmit",
    "preview": "vite preview",
    "preview:pages": "VITE_DEMO_BASE_URL=/auto-racer/ vite preview",
    "verify": "npm test && npm run lint && npm run build",
    "audit:artifact": "node scripts/audit-production-artifact.mjs dist",
    "simulation:log": "tsx scripts/log-simulation.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  }
}
